# Magica Inference API
MAGICA_API_KEY=
MAGICA_BASE_URL=https://inference.magica.com/v1

# Transloadit Community Plan
TRANSLOADIT_KEY=
TRANSLOADIT_SECRET=
TRANSLOADIT_TEMPLATE_ID=

# Outbound Webhooks (Optional)
WEBHOOK_URL=
WEBHOOK_SECRET=galaxy_default_webhook_secret_2026

# Trigger.dev Durable Background Tasks & Realtime
TRIGGER_SECRET_KEY=tr_dev_sk_...
TRIGGER_PROJECT_ID=proj_...
TRIGGER_API_URL=https://api.trigger.dev
