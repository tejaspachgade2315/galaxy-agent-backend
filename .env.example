# ==============================================================================
# GALAXY AGENT BACKEND - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Database (PostgreSQL 16)
DATABASE_URL=postgresql://galaxy:galaxy123@localhost:5432/galaxy_agent?schema=public

# Server Ports
PORT=3001
NEXT_PUBLIC_APP_URL=http://localhost:3000

# OpenRouter Free LLM Route
OPENROUTER_API_KEY=
